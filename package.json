{
  "name": "arkpay",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9",
  "scripts": {
    "dev:api": "pnpm --filter @arkpay/api start:dev",
    "dev:web": "pnpm --filter @arkpay/web dev",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @arkpay/api prisma:migrate",
    "build": "pnpm -r build",
    "test:connections": "node scripts/test-connections.mjs",
    "gmail:oauth": "node scripts/gmail-oauth.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
