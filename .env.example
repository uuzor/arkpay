# Copy to .env at the repo root and fill in. Never commit .env.
# The API reads ../../.env (repo root) when run from apps/api;
# docker compose reads this same file. One .env for everything.

# ---------- Postgres ----------
POSTGRES_USER=arkpay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arkpay
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arkpay:change-me@localhost:5432/arkpay?schema=public

# ---------- API ----------
NODE_ENV=development
API_PORT=3001
# Public URL of the deployed API. Used to register Telegram/PayPal webhooks.
# For the Vultr/sslip demo: https://api.<instance-ip>.sslip.io
API_PUBLIC_URL=https://api.<instance-ip>.sslip.io
# Reverse-proxy hostnames consumed by Caddy (production compose only).
APP_HOST=app.<instance-ip>.sslip.io
API_HOST=api.<instance-ip>.sslip.io

# ---------- PayPal (sandbox) ----------
# From https://developer.paypal.com/dashboard/applications/sandbox
# Staging-only: `owner:connect-paypal` copies these onto the owner workspace;
# the app resolves credentials per workspace from the DB at runtime.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Shared-subscription fallback for signature verification; workspaces with
# their own subscription use their stored id instead (see POST /paypal/webhooks).
PAYPAL_WEBHOOK_ID=

# ---------- Gmail ----------
# Google Cloud OAuth client in testing mode.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback
# Staging-only: `owner:connect-gmail` copies the refresh token onto the owner
# workspace (probed first); the poller syncs stored connections from the DB.
GMAIL_REFRESH_TOKEN=
# Inbox that refresh token belongs to, e.g. invoices@yourdomain.com
GMAIL_ADDRESS=
# Ingest worker. FULL_SYNC_MAX bounds the first run's catch-up depth.
GMAIL_POLL_ENABLED=true
GMAIL_POLL_INTERVAL_MS=60000
GMAIL_FULL_SYNC_MAX=50
# Max new messages fetched per history tick (quota safety; resumes next tick).
GMAIL_HISTORY_MAX=40

# ---------- Telegram ----------
# Bot token from @BotFather. Identity is per-workspace pairing links
# (dashboard Settings → Telegram → /link <code>); there is no global
# approver id. TELEGRAM_APPROVER_ID is retired and ignored when set.
TELEGRAM_BOT_TOKEN=
# Optional secret token Telegram sends in X-Telegram-Bot-Api-Secret-Token
# (verified in https://core.telegram.org/bots/api#setwebhook).
TELEGRAM_WEBHOOK_SECRET=
# polling = local getUpdates; webhook = Render (needs HTTPS API_PUBLIC_URL)
TELEGRAM_MODE=polling

# ---------- Auth (Google sign-in + tenancy) ----------
# Google Cloud OAuth client for sign-in. Falls back to the GMAIL_* client
# when unset (same Cloud project can serve both; register BOTH callback URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URIs (defaults: API_PUBLIC_URL + path). Must be registered in the
# Google Cloud console, or Google rejects the flow with redirect_uri_mismatch.
GOOGLE_REDIRECT_URI=
GOOGLE_GMAIL_REDIRECT_URI=
# Signs session cookies and OAuth state. REQUIRED. Rotate before deploy.
SESSION_SECRET=change-me-before-deploy
# Encrypts per-workspace PayPal client secrets at rest. 32 bytes, base64.
# openssl rand -base64 32
PAYPAL_SECRET_ENC_KEY=
# Web app origin (OAuth landing + login redirects).
WEB_APP_URL=http://localhost:3000
# Parent domain shared by the API and app hosts. REQUIRED in production when
# the OAuth callback lands on api.<host> and the SPA runs on app.<host>;
# without it the session cookie is host-only and the SPA cannot see it.
SESSION_COOKIE_DOMAIN=

# ---------- LLM ----------
# Active provider: Meta Model API (OpenAI-compatible) — Muse Spark 1.3.
# Anthropic/Claude is NOT used — no Anthropic key or SDK is required.
# META_* names are historical; they hold the endpoint/key/model actually in use.
LLM_PROVIDER=openai-compatible
META_MODEL_URL=https://api.meta.ai/v1
META_MODEL_API_KEY=
META_MODEL_NAME=muse-spark-1.3
# Agent chat loop model (falls back to META_MODEL_NAME when unset).
AGENT_MODEL_NAME=muse-wonder-1.0
# Below this confidence an extraction is flagged NEEDS_REVIEW, never acted on
LLM_MIN_CONFIDENCE=0.6

# ---------- Automations ----------
# Generic scheduler: one DB-backed runner for payroll, reminders and future jobs.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_SEED_DEFAULTS=true
SCHEDULER_STALE_RUN_MINUTES=30
# Automatic payment follow-ups for executed invoices.
FOLLOWUP_ENABLED=false
FOLLOWUP_CRON=0 */6 * * *
FOLLOWUP_DAYS=3,7,14
# Monthly payroll preparation. The schedule row is editable/pausable in the
# dashboard; these values only seed it on first boot.
PAYROLL_ENABLED=true
PAYROLL_CRON=0 9 1 * *
PAYROLL_TIMEZONE=UTC
# Meta Voice Transcribe model for Telegram voice notes (via /asr/transcribe).
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Vision-capable chat model on the same endpoint, for photographed receipts and
# image documents (Telegram photos). Required for image analysis. Verified
# working on Meta: muse-spark-1.3; muse-wonder-1.0 also transcribes images.
VISION_MODEL_NAME=muse-spark-1.3

# ---------- Safety Engine defaults ----------
APPROVAL_TTL_MINUTES=15
# 0 = human approval always (keep this for the MVP/hackathon)
AUTO_APPROVE_MAX_AMOUNT=0
VENDOR_DAILY_CAP=500
GLOBAL_DAILY_CAP=2000
# Payment Safety Engine. Every limit is a hard block when exceeded.
SAFETY_CURRENCY_ALLOWLIST=USD,EUR,GBP,NGN,CAD,AUD
INVOICE_MAX_AMOUNT=10000
BATCH_MAX_ITEMS=20
BATCH_MAX_TOTAL=5000
DUPLICATE_WINDOW_HOURS=24
AMOUNT_ANOMALY_FACTOR=2
DUE_DATE_MAX_DAYS=365

# ---------- Vultr ----------
# Infrastructure API key; allowlist the deployment IP in Account → API.
VULTR_API_KEY=
# Serverless Inference key (separate from the infrastructure API key).
VULTR_INFERENCE_API_KEY=
# Deployment metadata (filled by the provisioning flow; not read by the app).
VULTR_INSTANCE_ID=
VULTR_INSTANCE_IP=
VULTR_SSH_KEY_ID=
VULTR_SSH_KEY_PATH=

# ---------- PayPal platform (Partner Referrals / multiparty) ----------
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
PAYPAL_PLATFORM_MODE=sandbox
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_BN_CODE=
