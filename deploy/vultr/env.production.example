# Copy to /opt/arkpay/.env on the server. Never commit the real file.
NODE_ENV=production
API_PORT=3001
API_PUBLIC_URL=https://api.<instance-ip>.sslip.io
APP_HOST=app.<instance-ip>.sslip.io
API_HOST=api.<instance-ip>.sslip.io
GMAIL_REDIRECT_URI=https://api.<instance-ip>.sslip.io/auth/gmail/callback
WEB_APP_URL=https://app.<instance-ip>.sslip.io
# Parent domain shared by app + api so the session cookie crosses hosts.
SESSION_COOKIE_DOMAIN=<instance-ip>.sslip.io

# Postgres container
POSTGRES_USER=arkpay
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DB=arkpay
DATABASE_URL=postgresql://arkpay:replace-with-a-random-secret@db:5432/arkpay?schema=public

# App secrets (same shape as local .env)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVER_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_MODE=webhook

LLM_PROVIDER=openai-compatible
META_MODEL_URL=https://api.vultrinference.com/v1
META_MODEL_API_KEY=
META_MODEL_NAME=deepseek-v4.1-flash-1017

LLM_MIN_CONFIDENCE=0.6
APPROVAL_TTL_MINUTES=15
AUTO_APPROVE_MAX_AMOUNT=0
VENDOR_DAILY_CAP=500
GLOBAL_DAILY_CAP=2000
BATCH_MAX_ITEMS=20
BATCH_MAX_TOTAL=5000
SESSION_SECRET=replace-with-a-random-secret
# Encrypts per-workspace PayPal client secrets at rest. 32 bytes, base64.
PAYPAL_SECRET_ENC_KEY=

# ---------- PayPal platform (Partner Referrals / multiparty) ----------
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
PAYPAL_PLATFORM_MODE=sandbox
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_BN_CODE=
