{
  "name": "@arkpay/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "spike:invoice": "nest build && node dist/spike-invoice.js",
    "test:fixtures": "nest build && node ../../scripts/test-fixtures.mjs",
    "test:safety": "tsc -p tsconfig.safety.json && node --test dist-safety/safety.spec.js",
    "test:safety:e2e": "nest build && dotenv -e ../../.env -- node ../../scripts/test-safety-e2e.cjs",
    "test:scheduler": "tsc -p tsconfig.scheduler.json && node --test dist-scheduler/recurrence.spec.js",
    "test:scheduler:e2e": "nest build && dotenv -e ../../.env -- node ../../scripts/test-scheduler-e2e.cjs",
    "test:payouts:mock": "nest build && dotenv -e ../../.env -- node ../../scripts/test-payouts-mock.cjs",
    "test:agent-chat": "nest build && dotenv -e ../../.env -- node ../../scripts/test-agent-chat.cjs",
    "test:tenancy": "nest build && dotenv -e ../../.env -- node ../../scripts/test-tenancy.cjs",
    "test:multitenant": "nest build && dotenv -e ../../.env -- node ../../scripts/test-multitenant.cjs",
    "test:dashboard-api": "nest build && dotenv -e ../../.env -- node ../../scripts/test-dashboard-api.cjs",
    "owner:connect-gmail": "nest build && dotenv -e ../../.env -- node ../../scripts/connect-owner-gmail.cjs",
    "owner:connect-paypal": "nest build && dotenv -e ../../.env -- node ../../scripts/connect-owner-paypal.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.61",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@prisma/client": "^6.0.0",
    "ai": "^5.0.285",
    "axios": "^1.7.0",
    "cron-parser": "^5.10.3",
    "express": "^4.22.1",
    "googleapis": "^144.0.0",
    "nestjs-telegraf": "^2.8.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "telegraf": "^4.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
